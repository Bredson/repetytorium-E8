{
  "id": "potegi",
  "tytul": "Potęgi i pierwiastki",
  "modul": "C",
  "waga": "wysoka",
  "test_wstepny": [
    {
      "id": "tw-p1",
      "tresc": "Ile wynosi $2^5$?",
      "typ": "zamkniete",
      "opcje": ["10", "25", "32", "16"],
      "poprawna": "32"
    },
    {
      "id": "tw-p2",
      "tresc": "Co to jest $\\sqrt{49}$?",
      "typ": "zamkniete",
      "opcje": ["6", "7", "8", "9"],
      "poprawna": "7"
    }
  ],
  "cwiczenia": [
    {
      "id": "p1",
      "tresc": "Uprość: $a^3 \\cdot a^4$",
      "typ": "zamkniete",
      "opcje": ["$a^7$", "$a^{12}$", "$a^1$", "$2a^7$"],
      "poprawna": "$a^7$",
      "wskazowka": "Przy mnożeniu potęg o tej samej podstawie dodajesz wykładniki.",
      "przypomnij": "$a^m \\cdot a^n = a^{m+n}$"
    },
    {
      "id": "p2",
      "tresc": "Ile wynosi $3^{-2}$?",
      "typ": "zamkniete",
      "opcje": ["$-9$", "$-6$", "$\\frac{1}{9}$", "$9$"],
      "poprawna": "$\\frac{1}{9}$",
      "wskazowka": "Potęga o wykładniku ujemnym to odwrotność potęgi.",
      "przypomnij": "$a^{-n} = \\frac{1}{a^n}$"
    },
    {
      "id": "p3",
      "tresc": "Oblicz: $\\sqrt{4 \\cdot 25}$",
      "typ": "zamkniete",
      "opcje": ["10", "20", "15", "5"],
      "poprawna": "10",
      "wskazowka": "Pierwiastek z iloczynu to iloczyn pierwiastków.",
      "przypomnij": "$\\sqrt{a \\cdot b} = \\sqrt{a} \\cdot \\sqrt{b}$"
    },
    {
      "id": "p4",
      "tresc": "Uproszczona postać $\\frac{3^6}{3^2}$ to:",
      "typ": "zamkniete",
      "opcje": ["$3^3$", "$3^4$", "$3^8$", "$3^2$"],
      "poprawna": "$3^4$",
      "wskazowka": "Przy dzieleniu potęg o tej samej podstawie odejmujesz wykładniki.",
      "przypomnij": "$\\frac{a^m}{a^n} = a^{m-n}$"
    },
    {
      "id": "p5",
      "tresc": "Ile wynosi $4^0 + 2^{-1}$?",
      "typ": "zamkniete",
      "opcje": ["$\\frac{3}{2}$", "$1$", "$\\frac{1}{2}$", "$2$"],
      "poprawna": "$\\frac{3}{2}$",
      "wskazowka": "$a^0 = 1$ dla $a \\neq 0$; $2^{-1} = \\frac{1}{2}$.",
      "przypomnij": "$a^0 = 1$; $a^{-n} = \\frac{1}{a^n}$"
    }
  ],
  "zadania_otwarte": [
    {
      "id": "po1",
      "tresc": "Oblicz: $(2^3)^2$",
      "punkty": 2,
      "kroki": [
        {
          "id": "k1",
          "instrukcja": "Zastosuj wzór na potęgę potęgi i oblicz wynik",
          "oczekiwana": "64",
          "jednostka": null,
          "podpowiedz": "Potęga potęgi: mnożysz wykładniki."
        }
      ],
      "rozwiazanie_wzorcowe": "$(2^3)^2 = 2^{3 \\cdot 2} = 2^6 = 64$"
    },
    {
      "id": "po2",
      "tresc": "Oblicz: $(2^3)^2 \\cdot 2^{-4}$",
      "punkty": 2,
      "kroki": [
        {
          "id": "k1",
          "instrukcja": "Zastosuj wzór na potęgę potęgi: $(2^3)^2 = ?$",
          "oczekiwana": "64",
          "jednostka": null,
          "podpowiedz": "$(a^m)^n = a^{m \\cdot n}$; $(2^3)^2 = 2^6 = 64$"
        },
        {
          "id": "k2",
          "instrukcja": "Teraz pomnóż przez $2^{-4}$ i podaj wynik",
          "oczekiwana": "4",
          "jednostka": null,
          "podpowiedz": "$2^6 \\cdot 2^{-4} = 2^{6-4} = 2^2 = 4$"
        }
      ],
      "rozwiazanie_wzorcowe": "$(2^3)^2 \\cdot 2^{-4} = 2^6 \\cdot 2^{-4} = 2^2 = 4$"
    }
  ]
}
