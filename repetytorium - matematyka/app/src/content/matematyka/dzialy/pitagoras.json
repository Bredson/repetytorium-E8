      "kroki": [
        {
          "id": "k1",
          "instrukcja": "Zastosuj twierdzenie Pitagorasa i oblicz wysokość",
          "oczekiwana": "4",
          "jednostka": "m",
          "podpowiedz": "Zastosuj twierdzenie Pitagorasa: $h^2 + 3^2 = 5^2$."
        }
      ],
      "rozwiazanie_wzorcowe": "$h^2 = 25 - 9 = 16 \\Rightarrow h = 4$ m"
    }
  ]
